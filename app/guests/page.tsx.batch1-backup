// =========================================================
// FIELD
// =========================================================

function Field({
  label,
  required = false,
  children,
}: {
  label: string;
  required?: boolean;
  children: ReactNode;
}) {
  return (
    <div>
      <label style={fieldLabel}>
        {label}

        {required && (
          <span style={requiredMark}>
            *
          </span>
        )}
      </label>

      {children}
    </div>
  );
}

