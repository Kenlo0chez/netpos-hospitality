"use client";

import { useEffect, useMemo, useState } from "react";
import { useRouter } from "next/navigation";
import { supabase } from "@/src/lib/supabase";

// =========================================================
// TYPES
// =========================================================

type Property = {
  id: string;
  name: string;
};

type Room = {
  id: string;
  property_id: string;
  room_number: string;
  room_name: string | null;
  housekeeping_status: string | null;
  operational_status: string;
};

// =========================================================
// PAGE
// =========================================================

export default function HousekeepingPage() {
  const router = useRouter();

  const [properties, setProperties] = useState<Property[]>([]);
  const [propertyId, setPropertyId] = useState("");
  const [rooms, setRooms] = useState<Room[]>([]);

  const [loading, setLoading] = useState(true);
  const [loadingRooms, setLoadingRooms] = useState(false);
  const [updatingRoomId, setUpdatingRoomId] = useState("");

  const [message, setMessage] = useState("");
  const [errorMessage, setErrorMessage] = useState("");

  // =========================================================
  // INITIAL LOAD
  // =========================================================

  useEffect(() => {
    initialisePage();
  }, []);

  async function initialisePage() {
    setLoading(true);
    setErrorMessage("");

    try {
      const { data, error } = await supabase
        .from("properties")
        .select("id,name")
        .order("name");

      if (error) {
        throw new Error(error.message);
      }

      const rows = (data as Property[]) ?? [];

      setProperties(rows);

      if (rows.length > 0) {
        const firstPropertyId = rows[0].id;

        setPropertyId(firstPropertyId);

        await loadRooms(firstPropertyId);
      }
    } catch (error) {
      setErrorMessage(
        error instanceof Error
          ? error.message
          : "Could not load housekeeping."
      );
    } finally {
      setLoading(false);
    }
  }

  // =========================================================
  // LOAD ROOMS
  // =========================================================

  async function loadRooms(selectedPropertyId: string) {
    if (!selectedPropertyId) {
      setRooms([]);
      return;
    }

    setLoadingRooms(true);
    setErrorMessage("");

    try {
      const { data, error } = await supabase
        .from("rooms")
        .select(`
          id,
          property_id,
          room_number,
          room_name,
          housekeeping_status,
          operational_status
        `)
        .eq("property_id", selectedPropertyId)
        .order("room_number");

      if (error) {
        throw new Error(error.message);
      }

      setRooms((data as Room[]) ?? []);
    } catch (error) {
      setErrorMessage(
        error instanceof Error
          ? error.message
          : "Could not load rooms."
      );
    } finally {
      setLoadingRooms(false);
    }
  }

  // =========================================================
  // PROPERTY CHANGE
  // =========================================================

  async function changeProperty(value: string) {
    setPropertyId(value);
    setMessage("");
    setErrorMessage("");

    await loadRooms(value);
  }

  // =========================================================
  // CHANGE HOUSEKEEPING STATUS
  // =========================================================

  async function changeHousekeepingStatus(
    room: Room,
    status: "clean" | "dirty" | "cleaning"
  ) {
    if (room.operational_status !== "active") {
      return;
    }

    if (
      normaliseHousekeepingStatus(room.housekeeping_status) === status
    ) {
      return;
    }

    setUpdatingRoomId(room.id);
    setMessage("");
    setErrorMessage("");

    try {
      const { error } = await supabase
        .from("rooms")
        .update({
          housekeeping_status: status,
        })
        .eq("id", room.id);

      if (error) {
        throw new Error(error.message);
      }

      setRooms((currentRooms) =>
        currentRooms.map((currentRoom) =>
          currentRoom.id === room.id
            ? {
                ...currentRoom,
                housekeeping_status: status,
              }
            : currentRoom
        )
      );

      setMessage(
        `Room ${room.room_number} marked ${formatHousekeepingStatus(
          status
        )}.`
      );
    } catch (error) {
      setErrorMessage(
        error instanceof Error
          ? error.message
          : "Could not update housekeeping status."
      );
    } finally {
      setUpdatingRoomId("");
    }
  }

  // =========================================================
  // OUT OF SERVICE
  // =========================================================

  async function toggleOutOfService(room: Room) {
    const currentlyActive =
      room.operational_status === "active";

    const newStatus = currentlyActive
      ? "out_of_service"
      : "active";

    const question = currentlyActive
      ? `Take Room ${room.room_number} OUT OF SERVICE?\n\nThe room should not be used for new reservations until it is returned to service.`
      : `Return Room ${room.room_number} to service?`;

    const confirmed = window.confirm(question);

    if (!confirmed) {
      return;
    }

    setUpdatingRoomId(room.id);
    setMessage("");
    setErrorMessage("");

    try {
      const { error } = await supabase
        .from("rooms")
        .update({
          operational_status: newStatus,
        })
        .eq("id", room.id);

      if (error) {
        throw new Error(error.message);
      }

      setRooms((currentRooms) =>
        currentRooms.map((currentRoom) =>
          currentRoom.id === room.id
            ? {
                ...currentRoom,
                operational_status: newStatus,
              }
            : currentRoom
        )
      );

      if (newStatus === "out_of_service") {
        setMessage(
          `Room ${room.room_number} taken out of service.`
        );
      } else {
        setMessage(
          `Room ${room.room_number} returned to service.`
        );
      }
    } catch (error) {
      setErrorMessage(
        error instanceof Error
          ? error.message
          : "Could not update room."
      );
    } finally {
      setUpdatingRoomId("");
    }
  }

  // =========================================================
  // COUNTERS
  // =========================================================

  const cleanCount = useMemo(() => {
    return rooms.filter(
      (room) =>
        room.operational_status === "active" &&
        normaliseHousekeepingStatus(room.housekeeping_status) ===
          "clean"
    ).length;
  }, [rooms]);

  const dirtyCount = useMemo(() => {
    return rooms.filter(
      (room) =>
        room.operational_status === "active" &&
        normaliseHousekeepingStatus(room.housekeeping_status) ===
          "dirty"
    ).length;
  }, [rooms]);

  const cleaningCount = useMemo(() => {
    return rooms.filter(
      (room) =>
        room.operational_status === "active" &&
        normaliseHousekeepingStatus(room.housekeeping_status) ===
          "cleaning"
    ).length;
  }, [rooms]);

  const outOfServiceCount = useMemo(() => {
    return rooms.filter(
      (room) => room.operational_status !== "active"
    ).length;
  }, [rooms]);

  // =========================================================
  // LOADING
  // =========================================================

  if (loading) {
    return (
      <main style={pageStyle}>
        <div style={loadingBox}>Loading housekeeping...</div>
      </main>
    );
  }

  // =========================================================
  // PAGE
  // =========================================================

  return (
    <main style={pageStyle}>
      {/* =====================================================
          HEADER
      ===================================================== */}

      <header style={headerStyle}>
        <div>
          <button
            type="button"
            onClick={() => router.push("/reservations")}
            style={backButton}
          >
            ← Reservation Calendar
          </button>

          <div style={eyebrow}>NETPOS HOSPITALITY</div>

          <h1 style={titleStyle}>Housekeeping</h1>

          <div style={subtitleStyle}>
            Simple room cleaning status.
          </div>
        </div>

        <div style={propertyArea}>
          <label style={fieldLabel}>PROPERTY</label>

          <select
            value={propertyId}
            onChange={(event) =>
              changeProperty(event.target.value)
            }
            style={propertySelect}
          >
            {properties.length === 0 && (
              <option value="">No properties</option>
            )}

            {properties.map((property) => (
              <option
                key={property.id}
                value={property.id}
              >
                {property.name}
              </option>
            ))}
          </select>
        </div>
      </header>

      {/* =====================================================
          SUMMARY
      ===================================================== */}

      <section style={summaryGrid}>
        <SummaryCard
          label="Clean"
          value={cleanCount}
          type="clean"
        />

        <SummaryCard
          label="Dirty"
          value={dirtyCount}
          type="dirty"
        />

        <SummaryCard
          label="Cleaning"
          value={cleaningCount}
          type="cleaning"
        />

        <SummaryCard
          label="Out of Service"
          value={outOfServiceCount}
          type="out"
        />
      </section>

      {/* =====================================================
          MESSAGES
      ===================================================== */}

      {message && (
        <div style={successBox}>✓ {message}</div>
      )}

      {errorMessage && (
        <div style={errorBox}>{errorMessage}</div>
      )}

      {/* =====================================================
          ROOMS
      ===================================================== */}

      {loadingRooms ? (
        <div style={emptyBox}>Loading rooms...</div>
      ) : rooms.length === 0 ? (
        <div style={emptyBox}>
          No rooms found for this property.
        </div>
      ) : (
        <section style={roomsGrid}>
          {rooms.map((room) => {
            const housekeepingStatus =
              normaliseHousekeepingStatus(
                room.housekeeping_status
              );

            const outOfService =
              room.operational_status !== "active";

            const updating =
              updatingRoomId === room.id;

            return (
              <article
                key={room.id}
                style={{
                  ...roomCard,
                  ...getRoomCardStyle(
                    housekeepingStatus,
                    outOfService
                  ),
                  opacity: updating ? 0.65 : 1,
                }}
              >
                {/* ROOM TOP */}

                <div style={roomTop}>
                  <div>
                    <span style={roomLabel}>ROOM</span>

                    <strong style={roomNumber}>
                      {room.room_number}
                    </strong>

                    {room.room_name && (
                      <div style={roomName}>
                        {room.room_name}
                      </div>
                    )}
                  </div>

                  <HousekeepingBadge
                    status={housekeepingStatus}
                    outOfService={outOfService}
                  />
                </div>

                {/* CURRENT STATUS */}

                <div style={currentStatusArea}>
                  <span style={currentStatusLabel}>
                    CURRENT STATUS
                  </span>

                  <strong style={currentStatusValue}>
                    {outOfService
                      ? "Out of Service"
                      : formatHousekeepingStatus(
                          housekeepingStatus
                        )}
                  </strong>
                </div>

                {/* NORMAL HOUSEKEEPING BUTTONS */}

                {!outOfService && (
                  <div style={housekeepingButtons}>
                    <button
                      type="button"
                      disabled={updating}
                      onClick={() =>
                        changeHousekeepingStatus(
                          room,
                          "dirty"
                        )
                      }
                      style={{
                        ...housekeepingButton,
                        ...(housekeepingStatus === "dirty"
                          ? activeDirtyButton
                          : {}),
                      }}
                    >
                      Dirty
                    </button>

                    <button
                      type="button"
                      disabled={updating}
                      onClick={() =>
                        changeHousekeepingStatus(
                          room,
                          "cleaning"
                        )
                      }
                      style={{
                        ...housekeepingButton,
                        ...(housekeepingStatus ===
                        "cleaning"
                          ? activeCleaningButton
                          : {}),
                      }}
                    >
                      Cleaning
                    </button>

                    <button
                      type="button"
                      disabled={updating}
                      onClick={() =>
                        changeHousekeepingStatus(
                          room,
                          "clean"
                        )
                      }
                      style={{
                        ...housekeepingButton,
                        ...(housekeepingStatus === "clean"
                          ? activeCleanButton
                          : {}),
                      }}
                    >
                      ✓ Clean
                    </button>
                  </div>
                )}

                {/* OUT OF SERVICE */}

                <button
                  type="button"
                  disabled={updating}
                  onClick={() =>
                    toggleOutOfService(room)
                  }
                  style={
                    outOfService
                      ? returnServiceButton
                      : outOfServiceButton
                  }
                >
                  {updating
                    ? "Updating..."
                    : outOfService
                    ? "Return to Service"
                    : "Out of Service"}
                </button>
              </article>
            );
          })}
        </section>
      )}

      {/* =====================================================
          FOOTER
      ===================================================== */}

      <footer style={footerStyle}>
        <div style={footerHint}>
          Normal workflow:
          <strong> Dirty → Cleaning → Clean</strong>
        </div>

        <button
          type="button"
          onClick={() => {
            router.push("/reservations");
            router.refresh();
          }}
          style={finishButton}
        >
          ✓ Finish
        </button>
      </footer>
    </main>
  );
}

// =========================================================
// SUMMARY CARD
// =========================================================

function SummaryCard({
  label,
  value,
  type,
}: {
  label: string;
  value: number;
  type: "clean" | "dirty" | "cleaning" | "out";
}) {
  const styles = {
    clean: {
      background: "#edf8f0",
      borderColor: "#afd0b7",
      color: "#176332",
    },

    dirty: {
      background: "#fff0f0",
      borderColor: "#e2b0b0",
      color: "#982727",
    },

    cleaning: {
      background: "#fff9e6",
      borderColor: "#e5d18c",
      color: "#705900",
    },

    out: {
      background: "#f2f2f2",
      borderColor: "#cccccc",
      color: "#555555",
    },
  };

  const selectedStyle = styles[type];

  return (
    <div
      style={{
        ...summaryCard,
        ...selectedStyle,
      }}
    >
      <div>
        <span style={summarySmallLabel}>
          {label.toUpperCase()}
        </span>

        <div style={summaryDescription}>
          {type === "clean" && "Ready"}
          {type === "dirty" && "Needs cleaning"}
          {type === "cleaning" && "In progress"}
          {type === "out" && "Unavailable"}
        </div>
      </div>

      <strong style={summaryNumber}>{value}</strong>
    </div>
  );
}

// =========================================================
// HOUSEKEEPING BADGE
// =========================================================

function HousekeepingBadge({
  status,
  outOfService,
}: {
  status: string;
  outOfService: boolean;
}) {
  if (outOfService) {
    return (
      <span style={outBadge}>OUT OF SERVICE</span>
    );
  }

  if (status === "dirty") {
    return <span style={dirtyBadge}>DIRTY</span>;
  }

  if (status === "cleaning") {
    return (
      <span style={cleaningBadge}>CLEANING</span>
    );
  }

  return <span style={cleanBadge}>CLEAN</span>;
}

// =========================================================
// HELPERS
// =========================================================

function normaliseHousekeepingStatus(
  value: string | null | undefined
) {
  const cleaned = String(value ?? "")
    .trim()
    .toLowerCase();

  if (cleaned === "dirty") {
    return "dirty";
  }

  if (cleaned === "cleaning") {
    return "cleaning";
  }

  return "clean";
}

function formatHousekeepingStatus(value: string) {
  if (value === "dirty") {
    return "Dirty";
  }

  if (value === "cleaning") {
    return "Cleaning";
  }

  return "Clean";
}

function getRoomCardStyle(
  housekeepingStatus: string,
  outOfService: boolean
): React.CSSProperties {
  if (outOfService) {
    return {
      borderColor: "#c7c7c7",
      background: "#f8f8f8",
    };
  }

  if (housekeepingStatus === "dirty") {
    return {
      borderColor: "#dfaaaa",
      background: "#fffafa",
    };
  }

  if (housekeepingStatus === "cleaning") {
    return {
      borderColor: "#dfca7e",
      background: "#fffdf6",
    };
  }

  return {
    borderColor: "#a9ceb2",
    background: "#fbfffc",
  };
}

