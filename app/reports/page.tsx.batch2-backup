      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    .section {
      margin-top: 12px;
      break-inside: avoid;
    }
    .section h2 {
      color: #0D3F7A;
      font-size: 12px;
      margin: 0 0 6px;
    }
